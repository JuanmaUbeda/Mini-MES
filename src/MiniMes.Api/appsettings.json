{
  "ConnectionStrings": {
    "MiniMes": "Data Source=minimes.db"
  },
  "Erp": {
    "BaseUrl": "http://localhost:5063"
  },
  "Mixer": {
    "CycleSeconds": 20
  },
  "Output": {
    "Folder": "output/xml"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "AllowedHosts": "*"
}
