<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MiniMes.Core\MiniMes.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile the XSD into the DLL so the validator always finds it, wherever the app runs. -->
    <EmbeddedResource Include="BatchSchema.xsd" LogicalName="BatchSchema.xsd" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
